{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-center",
  "version": "2.0.0",
  "identifier": "com.cccenter.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "python3 bundle-web.py",
    "beforeBuildCommand": "python3 bundle-web.py && ./build-sidecar.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "cc-center",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/cc-center-server"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
